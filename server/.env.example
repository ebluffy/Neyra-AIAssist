# Скопируйте в server/.env и заполните значения.
# Файл .env в git не коммитится. Секреты сюда не коммитьте.

# ════════════════════════════════════════════════════════════
# 1) LLM — dual backend (AIHope + OpenRouter)
# ════════════════════════════════════════════════════════════
# Roles in server/config/llm.yaml: llm.talk_model / brain_model / … each has provider.
# Talk often OpenRouter (free Qwen); brain/memory/vision — AIHope.
OPENROUTER_API_KEY=
AIHOPE_API_KEY=

# Backlog: migrate secrets from .env into OS system environment variables for prod.

# ════════════════════════════════════════════════════════════
# 2) Discord (модуль server/modules/discord)
# ════════════════════════════════════════════════════════════
# Токен бота; настройки каналов — server/modules/discord/config.yaml
DISCORD_TOKEN=

# ════════════════════════════════════════════════════════════
# 3) Voice — STT / TTS секреты
# ════════════════════════════════════════════════════════════
# Канон voice.*: server/config/voice.yaml (STT и TTS независимо):
#   voice.stt.prefer / voice.tts.prefer: cloud | local
#   voice.stt.local.enable / voice.stt.cloud.enable
#   voice.stt.cloud.provider: deepgram | groq | openrouter
# Оба enable=false или нет ключей → soft ERROR в логе; ядро НЕ падает.
#
# OpenRouter Whisper: OPENROUTER_API_KEY выше + provider=openrouter
#   model: openai/whisper-large-v3-turbo (~$0.04/час)
#   docs: https://openrouter.ai/docs/guides/overview/multimodal/stt
#
# Deepgram (stt.cloud.provider=deepgram)
DEEPGRAM_API_KEY=

# Groq Whisper (stt.cloud.provider=groq)
GROQ_API_KEY=

# Yandex SpeechKit TTS (voice.tts.cloud)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Legacy alias for YANDEX_FOLDER_ID (warns once if used):
# YANDEX_ID_KEY=

# ════════════════════════════════════════════════════════════
# 4) Neyra HTTP API (core.api — server/core/api)
# ════════════════════════════════════════════════════════════
# Started with `python main.py` (host/port — server/config/server.yaml → api:).
# Public URL for clients/VPS: api.public_base_url + api.public_path_prefix
#   e.g. https://neyra.owyx.site/api/v1
# Optional Bearer for /v1 and WebSocket (empty = auth off, ONLY with loopback bind).
# Non-loopback bind (API_BIND_HOST=0.0.0.0 / LAN) REQUIRES at least one token or process refuses to start.
# Old INTERNAL_API_* names are rejected at startup (rename to API_*). No dual-read.
# API_TOKEN=
# API_VIEWER_TOKEN=
# API_MAINT_TOKEN=
# WEBHOOK_INBOUND_SECRET=

# Docker / bind override (overrides api.host after merge)
# API_BIND_HOST=0.0.0.0
# Optional public URL override without editing yaml:
# API_PUBLIC_BASE_URL=https://neyra.owyx.site

# Allow POST /v1/debug/lifecycle (prefer POST /v1/system/restart)
# NEYRA_DEBUG_LIFECYCLE=1

# ════════════════════════════════════════════════════════════
# 5) Модели / Hugging Face
# ════════════════════════════════════════════════════════════
# Optional. Public embeddings / Whisper usually work without a token.
# Prefer HF_TOKEN. HUGGING_FACE_HUB_TOKEN is a legacy alias (warns once).
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# ════════════════════════════════════════════════════════════
# 6) Плагины / прочее
# ════════════════════════════════════════════════════════════
# YANDEX_SEARCH_API_KEY=
# SCREEN_PROXY_SECRET=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# AGENT_PROXY_SECRET_KEY=
