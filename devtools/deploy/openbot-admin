#!/usr/bin/env bash
# Узкий root-хелпер для деплоя сайта Neyra. Лежит в репозитории, чтобы выкладку
# можно было воспроизвести: deploy-web.sh вызывает `sudo -n openbot-admin db-dump`.
#
# Установка (root): ставит neyra-web-setup.sh; вручную —
#   install -m 0755 devtools/deploy/openbot-admin /usr/local/sbin/openbot-admin
#   echo 'openbot ALL=(root) NOPASSWD: /usr/local/sbin/openbot-admin db-dump' \
#     > /etc/sudoers.d/openbot-admin
#   visudo -cf /etc/sudoers.d/openbot-admin
#
# Секреты БД не печатаются: команда отдаёт только путь и размер дампа.
#
# AR-27: root не пишет в каталоги, которыми владеет openbot. Дампы — в
# /var/backups/neyra-web (root:root 0700, родитель /var/backups принадлежит root),
# compose — /opt/neyra/web/docker-compose.yml в root-каталоге, переменные compose —
# /opt/neyra/web/db.env (root:root 0600). Родитель пути обязан принадлежать root и
# не быть writable для группы/других, иначе openbot мог бы подменить каталог или
# файл; при подмене на симлинк — отказ. Запись дампа: mktemp (O_EXCL, 0600)
# через fd проверенного каталога, затем mv — подложенная ссылка заменяется.
set -euo pipefail

COMPOSE_FILE="${NEYRA_COMPOSE_FILE:-/opt/neyra/web/docker-compose.yml}"
COMPOSE_ENV_FILE="${NEYRA_COMPOSE_ENV_FILE:-/opt/neyra/web/db.env}"
COMPOSE_PROJECT="${NEYRA_COMPOSE_PROJECT:-web}"
BACKUP_DIR="${NEYRA_BACKUP_DIR:-/var/backups/neyra-web}"
DB_SERVICE="${NEYRA_DB_SERVICE:-}"
DB_USER="${NEYRA_DB_USER:-neyra}"
DB_NAME="${NEYRA_DB_NAME:-neyra_web}"
KEEP_DUMPS="${NEYRA_KEEP_DUMPS:-10}"

die() { echo "$*" >&2; exit 1; }

usage() {
  cat >&2 <<'EOF'
Использование: openbot-admin db-dump
  db-dump  снять pg_dump базы сайта в BACKUP_DIR и напечатать path=/size=
EOF
}

# Родитель пути должен принадлежать root и не быть writable для группы/других:
# иначе openbot (владелец /opt/neyra/web) может подменить каталог или файл.
require_root_parent() {
  local target="$1" label="$2" dir owner perms
  dir="$(dirname "$target")"
  [ ! -L "$dir" ] || die "$label: родитель $dir — символическая ссылка, отказ"
  [ -d "$dir" ] || die "$label: нет родительского каталога $dir"
  owner="$(stat -c %u "$dir")"
  [ "$owner" = "0" ] || die "$label: родитель $dir принадлежит uid $owner, а не root"
  perms="$(stat -c %A "$dir")"
  case "${perms:5:1}${perms:8:1}" in
    *w*) die "$label: родитель $dir доступен на запись группе/другим ($perms)" ;;
  esac
}

# Файл, который читает root: владелец root и не writable для группы/других.
require_root_file() {
  local path="$1" label="$2" owner perms
  [ ! -L "$path" ] || die "$label: $path — символическая ссылка, отказ"
  [ -f "$path" ] || die "$label: нет файла $path"
  owner="$(stat -c %u "$path")"
  [ "$owner" = "0" ] || die "$label: $path принадлежит uid $owner, а не root"
  perms="$(stat -c %A "$path")"
  case "${perms:5:1}${perms:8:1}" in
    *w*) die "$label: $path доступен на запись группе/другим ($perms)" ;;
  esac
}

# Каталог дампов: root:root 0700. Симлинк на месте каталога — отказ.
prepare_backup_dir() {
  [ ! -L "$BACKUP_DIR" ] || die "BACKUP_DIR $BACKUP_DIR — символическая ссылка, отказ"
  if [ -e "$BACKUP_DIR" ] && [ ! -d "$BACKUP_DIR" ]; then
    die "BACKUP_DIR $BACKUP_DIR — не каталог"
  fi
  mkdir -p "$BACKUP_DIR"
  chown root:root "$BACKUP_DIR"
  chmod 0700 "$BACKUP_DIR"
}

# Имя сервиса БД: явный NEYRA_DB_SERVICE, иначе postgres (как в
# web/docker-compose.yml), затем db (так сервис звался на старых площадках).
resolve_db_service() {
  if [ -n "$DB_SERVICE" ]; then
    printf '%s\n' "$DB_SERVICE"
    return 0
  fi
  local candidate
  for candidate in postgres db; do
    if compose exec -T "$candidate" pg_isready -U "$DB_USER" -d "$DB_NAME" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  # Ни один не ответил: отдаём первый по порядку и покажем ошибку pg_dump.
  printf '%s\n' postgres
}

# Все параметры compose — явно из root-каталога: openbot-овый .env не участвует.
compose() {
  docker compose -p "$COMPOSE_PROJECT" --env-file "$COMPOSE_ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

case "${1:-}" in
  db-dump)
    command -v docker >/dev/null 2>&1 || die "docker не найден"
    require_root_parent "$BACKUP_DIR" "BACKUP_DIR"
    require_root_parent "$COMPOSE_FILE" "COMPOSE_FILE"
    require_root_file "$COMPOSE_FILE" "COMPOSE_FILE"
    require_root_parent "$COMPOSE_ENV_FILE" "COMPOSE_ENV_FILE"
    require_root_file "$COMPOSE_ENV_FILE" "COMPOSE_ENV_FILE"

    umask 077
    prepare_backup_dir

    # Дескриптор на проверенный каталог: mktemp и mv идут через него, поэтому
    # даже подмена BACKUP_DIR на симлинк после проверки не уведёт запись.
    exec {backup_fd}<"$BACKUP_DIR" || die "не удалось открыть BACKUP_DIR"
    [ "$(stat -Lc %u "/proc/self/fd/$backup_fd")" = "0" ] \
      || die "BACKUP_DIR $BACKUP_DIR подменён: владелец не root"

    service="$(resolve_db_service)"
    tmp="$(mktemp "/proc/self/fd/$backup_fd/.pre-migrate.XXXXXXXX")"
    trap 'rm -f "$tmp"' EXIT
    if ! compose exec -T "$service" pg_dump -U "$DB_USER" -d "$DB_NAME" -Fc > "$tmp"; then
      die "pg_dump не выполнился (сервис $service)"
    fi
    [ -s "$tmp" ] || die "дамп пуст (сервис $service)"

    chown root:root "$tmp"
    chmod 0600 "$tmp"
    name="pre-migrate-$(date +%Y%m%d-%H%M%S).dump"
    # Каталог мог быть подменён симлинком уже после проверки: сравниваем inode
    # открытого fd с тем, что сейчас лежит по пути. Запись всё равно шла через
    # fd в проверенный каталог, но отдать корректный path= мы не можем — отказ.
    [ "$(stat -c %i "$BACKUP_DIR")" = "$(stat -Lc %i "/proc/self/fd/$backup_fd")" ] \
      || die "BACKUP_DIR $BACKUP_DIR подменён после проверки — дамп не сохранён"
    # rename внутри открытого каталога: подложенный симлинк заменяется целиком.
    mv -f "$tmp" "/proc/self/fd/$backup_fd/$name"
    trap - EXIT
    dump="$BACKUP_DIR/$name"

    # Оставляем последние KEEP_DUMPS копий, остальные удаляем.
    find "$BACKUP_DIR" -maxdepth 1 -type f -name 'pre-migrate-*.dump' -printf '%T@ %p\n' 2>/dev/null \
      | sort -rn | tail -n +"$((KEEP_DUMPS + 1))" | cut -d' ' -f2- | xargs -r rm -f
    echo "path=$dump"
    echo "size=$(stat -c%s "$dump")"
    ;;
  *)
    usage
    exit 2
    ;;
esac
