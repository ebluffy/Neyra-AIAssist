{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neyra",
  "version": "0.1.0",
  "identifier": "site.owyx.neyra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Neyra",
        "width": 1040,
        "height": 760,
        "minWidth": 620,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; connect-src ipc: http://ipc.localhost blob:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQUZDMTFGQjk5MUZCQjYKUldTMis1RzVIOEd2R21yaFQxK0VMK1NVL3VTU3N0QU83Q2Vud2JlaENldDMxUGJKUWtodjZTVEQK",
      "endpoints": [
        "https://github.com/ebluffy/Neyra-AIAssist/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
