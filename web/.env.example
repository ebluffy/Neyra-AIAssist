DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Required only for docker compose; use the same password in DATABASE_URL.
POSTGRES_PASSWORD=
NEYRA_WS_URL=
NEYRA_SERVICE_KEY=
NEYRA_IDENTITY_JWT_SECRET=
NEYRA_IDENTITY_JWT_ISSUER=

# Отключение бандлинга нативных модулей bufferutil и utf-8-validate для ws в standalone-сборке Next.js.
# Форсирует чистый JS-фолбэк маскирования WS-кадров и предотвращает ошибку TypeError: b.mask is not a function.
WS_NO_BUFFER_UTIL=1
WS_NO_UTF_8_VALIDATE=1
